APP_NAME=BIS SmartSpec AI
DEBUG=true

# Database
DATABASE_URL=sqlite:///./data/bis_smartspec.db

# Vector DB  
VECTOR_DB_PATH=./chroma_db
COLLECTION_NAME=bis_standards

# Embedding Model (sentence-transformers)
# For Hindi+English support, use: paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_MODEL=all-MiniLM-L6-v2

# LLM Provider: "ollama" or "mock" (mock requires no external service)
LLM_PROVIDER=mock

# Ollama (optional - for local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# OpenAI-compatible (optional)
LLM_API_KEY=

# Retrieval weights (should sum to ~1.0)
SEMANTIC_WEIGHT=0.65
LEXICAL_WEIGHT=0.20
METADATA_WEIGHT=0.15

# Upload
MAX_UPLOAD_MB=20
UPLOAD_DIR=./uploads

# CORS (comma-separated origins for production)
# CORS_ORIGINS=https://yourfrontend.vercel.app
